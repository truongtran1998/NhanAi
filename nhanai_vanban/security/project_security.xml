<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">
    <record id="group_own_task" model="res.groups">
        <field name="name">Văn bản nội bộ 1</field>
        <field name="category_id" ref="base.module_category_services_project"/>
    </record>
</data>
<data noupdate="1">
    <record id="project_task_custom" model="ir.rule">
        <field name="name">see own task</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('nhanai_vanban.group_own_task'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="project_activity_custom" model="ir.rule">
        <field name="name">see own activity</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="domain_force">	[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('nhanai_vanban.group_own_task'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</data>
</odoo>
